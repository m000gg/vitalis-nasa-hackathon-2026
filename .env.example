# Supabase Remote Database Configuration
# Copy this file to .env.local (which is gitignored) and fill in your project values.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
# Or legacy anon key:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Keep the Service Role Key & DB credentials strictly on the server (never prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_DB_NAME=your-database-name
SUPABASE_DB_PASSWORD=your-database-password

# NASA DONKI is called server-side only. DEMO_KEY is a development fallback;
# use a personal API key for reliable hackathon demos.
NASA_API_KEY=your-nasa-api-key
# Optional official proxy/base override, without a trailing slash.
# NASA_DONKI_BASE_URL=https://api.nasa.gov/DONKI

# Optional: comma-separated extra hostnames if deployed beyond localhost:1654
# ALLOWED_HOSTS=app.website.com,website.com
