# Supabase Remote Database Configuration
# Copy this file to .env.local (which is gitignored) and fill in your project values.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Keep the Service Role Key strictly on the server (never prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Optional: comma-separated extra hostnames if deployed beyond localhost:1654
# ALLOWED_HOSTS=app.website.com,website.com
